---
import Base from '../layouts/Base.astro';
import Apertura from '../components/Apertura.astro';
import Sezione from '../components/Sezione.astro';
import Scheda from '../components/Scheda.astro';
import ElencoPunti from '../components/ElencoPunti.astro';
import { sito, mailto } from '../config';
import { sezioni } from '../data/sezioni';
import {
  chiSono,
  servizi,
  etichettaPrezzo,
  comeLavoro,
  perche,
  lavori,
  contatti,
} from '../data/testi';
import { datiStrutturati } from '../lib/dati-strutturati';

const mostraLavori = sito.mostraLavori && lavori.length > 0;
---

<Base datiStrutturati={datiStrutturati}>
  <Apertura />

  <Sezione sezione={sezioni.chiSono}>
    {chiSono.map((paragrafo) => <p data-comparsa>{paragrafo}</p>)}
  </Sezione>

  <Sezione sezione={sezioni.servizi}>
    <ul class="schede" data-comparsa-gruppo>
      {
        servizi.map((servizio) => (
          <li>
            <Scheda
              titolo={servizio.titolo}
              etichetta={etichettaPrezzo(servizio)}
              evidenziata={servizio.evidenziato}
            >
              <p>{servizio.descrizione}</p>
              {servizio.tempi && <p class="scheda__nota">Tempi: {servizio.tempi}.</p>}
            </Scheda>
          </li>
        ))
      }
    </ul>
  </Sezione>

  <Sezione sezione={sezioni.comeLavoro}>
    <ElencoPunti voci={comeLavoro} numerato />
  </Sezione>

  <Sezione sezione={sezioni.perche} variante="banda">
    <ElencoPunti voci={perche} />
  </Sezione>

  {
    mostraLavori && (
      <Sezione sezione={sezioni.lavori}>
        <ul class="schede schede--adattive" data-comparsa-gruppo>
          {lavori.map((lavoro) => (
            <li>
              <Scheda titolo={lavoro.titolo}>
                <p>{lavoro.descrizione}</p>
                {lavoro.url && (
                  <p class="scheda__nota">
                    <a href={lavoro.url}>Visita il sito</a>
                  </p>
                )}
              </Scheda>
            </li>
          ))}
        </ul>
      </Sezione>
    )
  }

  <Sezione sezione={sezioni.contatti}>
    <p data-comparsa>{contatti.invito}</p>
    <p class="contatti__email" data-comparsa><a href={mailto}>{sito.email}</a></p>
  </Sezione>
</Base>
