---
import Base from '../layouts/Base.astro';
import Apertura from '../components/Apertura.astro';
import Sezione from '../components/Sezione.astro';
import Scheda from '../components/Scheda.astro';
import Carosello from '../components/Carosello.astro';
import ElencoPunti from '../components/ElencoPunti.astro';
import Profili from '../components/Profili.astro';
import Domande from '../components/Domande.astro';
import ModuloContatto from '../components/ModuloContatto.astro';
import { sito, mailto } from '../config';
import { linkSezione, sezioni } from '../data/sezioni';
import {
  chiSono,
  servizi,
  etichettaPrezzo,
  comeLavoro,
  perche,
  lavori,
  linkLavoro,
  domande,
  contatti,
  richiestaServizio,
  carosello,
} from '../data/testi';
import { datiStrutturati } from '../lib/dati-strutturati';

const mostraLavori = sito.mostraLavori && lavori.length > 0;
---

<Base datiStrutturati={datiStrutturati}>
  <Apertura />

  <Sezione sezione={sezioni.chiSono}>
    {chiSono.map((paragrafo) => <p data-comparsa>{paragrafo}</p>)}
  </Sezione>

  <Sezione sezione={sezioni.servizi}>
    <Carosello
      etichetta={carosello.gruppo}
      voci={servizi.map((servizio) => carosello.vaiA(servizio.titolo))}
    >
      <ul class="schede" data-comparsa-gruppo>
        {
          servizi.map((servizio) => (
            <li>
              <Scheda
                titolo={servizio.titolo}
                etichetta={etichettaPrezzo(servizio)}
                nota={servizio.tempi && `Tempi: ${servizio.tempi}.`}
                azione={{
                  href: linkSezione(sezioni.contatti),
                  testo: richiestaServizio.link,
                  servizio: servizio.titolo,
                }}
              >
                <p>{servizio.descrizione}</p>
              </Scheda>
            </li>
          ))
        }
      </ul>
    </Carosello>
  </Sezione>

  <Sezione sezione={sezioni.comeLavoro}>
    <ElencoPunti voci={comeLavoro} numerato />
  </Sezione>

  <Sezione sezione={sezioni.perche} variante="banda">
    <ElencoPunti voci={perche} />
  </Sezione>

  {
    mostraLavori && (
      <Sezione sezione={sezioni.lavori}>
        <ul class="schede schede--adattive" data-comparsa-gruppo>
          {lavori.map((lavoro) => (
            <li>
              <Scheda
                titolo={lavoro.titolo}
                azione={lavoro.url ? { href: lavoro.url, testo: linkLavoro } : undefined}
              >
                <p>{lavoro.descrizione}</p>
              </Scheda>
            </li>
          ))}
        </ul>
      </Sezione>
    )
  }

  {
    domande.length > 0 && (
      <Sezione sezione={sezioni.domande}>
        <Domande voci={domande} />
      </Sezione>
    )
  }

  <Sezione sezione={sezioni.contatti}>
    <p data-comparsa>{contatti.invito}</p>
    <ModuloContatto servizi={servizi.map((servizio) => servizio.titolo)} />
    <p class="contatti__alternative" data-comparsa>
      {contatti.alternativa} <a href={mailto}>{sito.email}</a>.<br />
      {contatti.profili} <Profili />.
    </p>
  </Sezione>
</Base>
