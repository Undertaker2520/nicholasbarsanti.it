---
import Pulsante from './Pulsante.astro';

interface Azione {
  href: string;
  testo: string;
}

interface Props {
  titolo: string;
  /** Riga sotto il titolo, per esempio il prezzo. */
  etichetta?: string;
  /** Riga discreta in fondo, per esempio i tempi. */
  nota?: string;
  /** Link in fondo: rende cliccabile tutta la scheda. */
  azione?: Azione;
}

const { titolo, etichetta, nota, azione } = Astro.props;
---

<article class="scheda">
  <h3 class="scheda__titolo">{titolo}</h3>
  {etichetta && <p class="scheda__etichetta">{etichetta}</p>}
  <div class="scheda__corpo"><slot /></div>
  {
    (nota || azione) && (
      <div class="scheda__fondo">
        {nota && <p class="scheda__nota">{nota}</p>}
        {azione && (
          <p class="scheda__azione">
            <Pulsante href={azione.href} dimensione="piccolo" class="scheda__link">
              {azione.testo}
              <span class="solo-lettori-schermo">: {titolo}</span>
              <span class="scheda__freccia" aria-hidden="true">→</span>
            </Pulsante>
          </p>
        )}
      </div>
    )
  }
</article>
