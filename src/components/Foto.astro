---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { sito } from '../config';

interface Props {
  alt: string;
}

const { alt } = Astro.props;

// La foto è facoltativa: se src/assets/nicholas.jpg non esiste si mostra il segnaposto.
const trovate = import.meta.glob<{ default: ImageMetadata }>('../assets/nicholas.jpg', {
  eager: true,
});
const foto = Object.values(trovate)[0]?.default;

const iniziali = sito.nome
  .split(' ')
  .map((parola) => parola[0])
  .join('');

// Deve corrispondere a $foto-dimensioni in src/styles/_variabili.scss.
const sizes = '(min-width: 40rem) 16rem, 10rem';
// 10rem e 16rem a densità 1x e 2x; 512 px è anche il massimo pubblicato.
const widths = [160, 256, 320, 512];
---

{
  foto ? (
    <Picture
      class="foto"
      src={foto}
      alt={alt}
      formats={['avif', 'webp']}
      width={Math.max(...widths)}
      widths={widths}
      sizes={sizes}
      priority
    />
  ) : (
    <div class="foto foto--segnaposto" aria-hidden="true">
      {iniziali}
    </div>
  )
}
