---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { sito } from '../config';

interface Props {
  alt: string;
}

const { alt } = Astro.props;

// La foto è facoltativa: se src/assets/nicholas.jpg non esiste si mostra il segnaposto.
const trovate = import.meta.glob<{ default: ImageMetadata }>('../assets/nicholas.jpg', {
  eager: true,
});
const foto = Object.values(trovate)[0]?.default;

const iniziali = sito.nome
  .split(' ')
  .map((parola) => parola[0])
  .join('');

// Deve corrispondere a $foto-dimensioni in src/styles/_variabili.scss.
const sizes = '(min-width: 40rem) 12.5rem, 10rem';
// 10rem e 12.5rem a densità 1x e 2x, senza superare la larghezza dell'originale
// (le foto non vengono mai ingrandite); 400 px è il massimo pubblicato.
const LARGHEZZE = [160, 200, 320, 400];
// Qualità più alta del predefinito (circa 50): capelli e tessuti restano definiti.
const QUALITA = 80;
const massima = Math.min(foto?.width ?? 0, Math.max(...LARGHEZZE));
const widths = [...LARGHEZZE.filter((larghezza) => larghezza < massima), massima];
---

{
  foto ? (
    <Picture
      class="foto"
      src={foto}
      alt={alt}
      formats={['avif', 'webp']}
      width={massima}
      widths={widths}
      sizes={sizes}
      quality={QUALITA}
      priority
    />
  ) : (
    <div class="foto foto--segnaposto" aria-hidden="true">
      {iniziali}
    </div>
  )
}
